    "html": "<!--\n  GoTalents / \"Талант в Каждом\" Telegram community block (universal).\n  Pattern + chat data lifted from kb-migration/gotalents-kb/src/pages/chaty.astro on 2026-06-02.\n  Paste into the \"html\" field of a Topic HTML Blocks block object; set topic_ids.\n  Pure CSS only (component injects via innerHTML, so <script> will NOT run).\n  Scoped under .gtc so nothing leaks into the rest of the forum.\n\n  !!! PLACEHOLDER \"ОНЛАЙН\" COUNTS !!!  every \"N онлайн\" value below is a GUESS.\n      These are static numbers (no live data possible in pure HTML). Replace each\n      one with a real/representative value before going live, or have a job update them.\n  TODO: the RFE row reuses the main invite (placeholder in the KB source).\n        Replace href https://t.me/+-wWqGJ0zTjFhOGFh on the RFE row with the real invite.\n-->\n<div class=\"gtc\">\n  <style>\n    .gtc *{box-sizing:border-box;}\n    .gtc{\n      --v:#7c4dff;--v2:#9333ea;--pink:#ec4899;--ink:#161a2e;--mut:#6b7280;--line:#e8eaf1;--grn:#16a34a;\n      position:relative;max-width:680px;margin:1.25rem auto;padding:17px 18px 15px;\n      background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;\n      box-shadow:0 12px 32px -14px rgba(30,25,80,.20);\n      font-family:inherit;color:var(--ink);-webkit-font-smoothing:antialiased;\n    }\n    .gtc::before{content:\"\";position:absolute;top:0;left:0;right:0;height:3px;\n      background:linear-gradient(90deg,#229ED9,var(--v),var(--pink));}\n\n    /* online indicator - reused on every chat */\n    .gtc__on{display:inline-flex;align-items:center;gap:.32rem;font-size:.78rem;font-weight:700;color:var(--grn);white-space:nowrap;}\n    .gtc__on::before{content:\"\";width:6px;height:6px;border-radius:50%;background:#22c55e;flex:none;}\n    .gtc__on--right{margin-left:auto;}\n\n    .gtc__top{display:flex;align-items:center;gap:14px;}\n    .gtc__id{display:flex;align-items:center;gap:12px;min-width:0;flex:1;}\n    .gtc__coin{position:relative;flex:none;width:46px;height:46px;border-radius:14px;\n      background:linear-gradient(135deg,#2aa9e0,#1d8fc4);display:flex;align-items:center;justify-content:center;\n      box-shadow:0 7px 16px -6px rgba(34,158,217,.75);}\n    .gtc__coin svg{width:24px;height:24px;}\n    .gtc__coin i{position:absolute;right:-2px;bottom:-2px;width:13px;height:13px;border-radius:50%;\n      background:#22c55e;border:2.5px solid #fff;box-shadow:0 0 0 0 rgba(34,197,94,.6);animation:gtcpulse 2.2s infinite;}\n    @keyframes gtcpulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.5)}70%{box-shadow:0 0 0 7px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}\n    .gtc__name{display:block;font-weight:800;font-size:1.1rem;letter-spacing:-.01em;line-height:1.2;}\n    .gtc__stats{display:block;margin-top:3px;font-size:.83rem;color:var(--mut);line-height:1.5;}\n    .gtc__stats .gtc__on{vertical-align:baseline;}\n    .gtc__stats b{color:var(--v2);font-weight:700;}\n    .gtc__stats em{font-style:normal;margin:0 .45em;color:#cdd1de;}\n    .gtc__btn{flex:none;display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;\n      padding:.72rem 1.3rem;border-radius:11px;font-weight:700;font-size:.95rem;\n      color:#fff!important;text-decoration:none!important;\n      background:linear-gradient(135deg,var(--v),var(--pink));\n      box-shadow:0 9px 20px -8px rgba(124,77,255,.8);\n      transition:transform .18s ease,box-shadow .18s ease,filter .18s ease;}\n    .gtc__btn svg{transition:transform .18s ease;}\n    .gtc__btn:hover{transform:translateY(-2px);box-shadow:0 13px 26px -8px rgba(124,77,255,.9);filter:saturate(1.08);}\n    .gtc__btn:hover svg{transform:translateX(3px);}\n\n    .gtc__seclbl{font-size:.74rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#9aa0b4;\n      margin:15px 0 9px;padding-top:13px;border-top:1px solid var(--line);}\n\n    /* profile chats grid */\n    .gtc__grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;}\n    .gtc__item{display:flex;align-items:center;gap:.6rem;padding:.5rem .6rem;border-radius:12px;\n      border:1px solid var(--line);background:#fcfcfe;text-decoration:none!important;color:var(--ink)!important;\n      transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease;}\n    .gtc__item:hover{transform:translateY(-1px);box-shadow:0 8px 18px -12px rgba(30,25,80,.5);}\n    .gtc__ico{flex:none;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;line-height:1;}\n    .gtc__txt{display:flex;flex-direction:column;line-height:1.25;min-width:0;}\n    .gtc__txt b{font-size:.88rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n    .gtc__i-it{background:#e0f4fa;}      .gtc__item:has(.gtc__i-it):hover{border-color:#0891b2;}\n    .gtc__i-eng{background:#eef1f5;}     .gtc__item:has(.gtc__i-eng):hover{border-color:#475569;}\n    .gtc__i-biz{background:#e3f7ee;}     .gtc__item:has(.gtc__i-biz):hover{border-color:#10b981;}\n    .gtc__i-mkt{background:#fdeede;}     .gtc__item:has(.gtc__i-mkt):hover{border-color:#f97316;}\n    .gtc__i-dsn{background:#fbe8fb;}     .gtc__item:has(.gtc__i-dsn):hover{border-color:#d946ef;}\n    .gtc__i-bty{background:#fde6f1;}     .gtc__item:has(.gtc__i-bty):hover{border-color:#ec4899;}\n    .gtc__i-edu{background:#e7e9fd;}     .gtc__item:has(.gtc__i-edu):hover{border-color:#6366f1;}\n    .gtc__i-spt{background:#fde6e6;}     .gtc__item:has(.gtc__i-spt):hover{border-color:#ef4444;}\n\n    /* always-visible special chats */\n    .gtc__special{display:grid;gap:.5rem;margin-top:.5rem;}\n    .gtc__row{display:flex;align-items:center;gap:.7rem;padding:.6rem .7rem;border-radius:12px;\n      text-decoration:none!important;color:var(--ink)!important;border:1px solid var(--line);background:#fff;\n      transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease;}\n    .gtc__row:hover{transform:translateY(-1px);box-shadow:0 8px 18px -12px rgba(30,25,80,.5);}\n    .gtc__row--amber:hover{border-color:#f59e0b;} .gtc__row--rose:hover{border-color:#e11d48;}\n    .gtc__badge{flex:none;width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;\n      color:#fff;font-weight:800;font-size:.72rem;}\n    .gtc__badge--amber{background:linear-gradient(135deg,#f59e0b,#f97316);}\n    .gtc__badge--rose{background:linear-gradient(135deg,#fb7185,#e11d48);}\n    .gtc__rt{display:flex;flex-direction:column;line-height:1.25;min-width:0;}\n    .gtc__rt b{font-size:.9rem;font-weight:700;}\n    .gtc__rt span{font-size:.79rem;color:var(--mut);}\n\n    .gtc__foot{margin-top:12px;font-size:.78rem;color:#9aa0b4;display:flex;align-items:center;gap:.4rem;}\n    .gtc__foot svg{width:13px;height:13px;flex:none;}\n    @media (max-width:560px){\n      .gtc__top{flex-wrap:wrap;}\n      .gtc__btn{width:100%;justify-content:center;order:3;margin-top:6px;}\n      .gtc__grid{grid-template-columns:1fr;}\n    }\n  </style>\n\n  <div class=\"gtc__top\">\n    <div class=\"gtc__id\">\n      <span class=\"gtc__coin\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M21.5 4.3 2.9 11.4c-1 .4-1 1.9.1 2.2l4.6 1.4 1.8 5.6c.3.9 1.4 1 1.9.2l2.5-3.6 4.7 3.5c.7.5 1.7.1 1.9-.7l3-13.9c.2-1-.8-1.9-1.9-1.5Z\" fill=\"#fff\"/></svg>\n        <i></i>\n      </span>\n      <span>\n        <span class=\"gtc__name\">Талант в Каждом</span>\n        <span class=\"gtc__stats\"><b>13 000+</b> участников<em>·</em><b>11</b> чатов<em>·</em><span class=\"gtc__on\">340 онлайн</span></span>\n      </span>\n    </div>\n    <a class=\"gtc__btn\" href=\"https://t.me/+-wWqGJ0zTjFhOGFh\" target=\"_blank\" rel=\"noopener nofollow\">\n      Вступить бесплатно\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n    </a>\n  </div>\n\n  <div class=\"gtc__seclbl\">Чаты под ваш профиль</div>\n  <div class=\"gtc__grid\">\n    <a class=\"gtc__item\" href=\"https://t.me/+bUqdWHoy74E3NDQy\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-it\">💻</span><span class=\"gtc__txt\"><b>IT</b><span class=\"gtc__on\">180 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+EpzIwOQPajVmODdi\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-eng\">⚙️</span><span class=\"gtc__txt\"><b>Инженеры</b><span class=\"gtc__on\">110 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+mJmQTYSPedZmNGNi\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-biz\">📈</span><span class=\"gtc__txt\"><b>Предприниматели</b><span class=\"gtc__on\">70 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+hCRVbjiHzuA4Njhi\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-mkt\">📣</span><span class=\"gtc__txt\"><b>Маркетологи</b><span class=\"gtc__on\">54 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+d8_sqc1OR7s1NzNi\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-dsn\">🎨</span><span class=\"gtc__txt\"><b>Дизайнеры</b><span class=\"gtc__on\">38 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+oYyogMbx2840ZThi\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-bty\">💄</span><span class=\"gtc__txt\"><b>Бьюти и Мода</b><span class=\"gtc__on\">61 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+7BBQjJlCL2Y5M2Fi\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-edu\">🎓</span><span class=\"gtc__txt\"><b>Педагоги</b><span class=\"gtc__on\">29 онлайн</span></span></a>\n    <a class=\"gtc__item\" href=\"https://t.me/+N8p6WXzvN-FlNTk6\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__ico gtc__i-spt\">🏆</span><span class=\"gtc__txt\"><b>Спорт</b><span class=\"gtc__on\">24 онлайн</span></span></a>\n  </div>\n\n  <div class=\"gtc__special\">\n    <a class=\"gtc__row gtc__row--amber\" href=\"https://t.me/ap221g\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__badge gtc__badge--amber\">221g</span>\n      <span class=\"gtc__rt\"><b>Административная проверка (221g)</b><span>опыт ожидания, mandamus и сроки</span></span>\n      <span class=\"gtc__on gtc__on--right\">130 онлайн</span>\n    </a>\n    <a class=\"gtc__row gtc__row--rose\" href=\"https://t.me/+-wWqGJ0zTjFhOGFh\" target=\"_blank\" rel=\"noopener nofollow\">\n      <span class=\"gtc__badge gtc__badge--rose\">RFE</span>\n      <span class=\"gtc__rt\"><b>Получили RFE?</b><span>закрытый чат по ответам на RFE и NOID</span></span>\n      <span class=\"gtc__on gtc__on--right\">70 онлайн</span>\n    </a>\n  </div>\n\n  <div class=\"gtc__foot\">\n    <svg viewBox=\"0 0 24 24\" fill=\"#229ED9\"><path d=\"M21.5 4.3 2.9 11.4c-1 .4-1 1.9.1 2.2l4.6 1.4 1.8 5.6c.3.9 1.4 1 1.9.2l2.5-3.6 4.7 3.5c.7.5 1.7.1 1.9-.7l3-13.9c.2-1-.8-1.9-1.9-1.5Z\"/></svg>\n    Бесплатно · без регистрации · вопросы открыты\n  </div>\n</div>\n"
  }
]